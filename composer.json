{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "nwidart/laravel-modules": "^12.0",
        "spatie/laravel-permission": "^6.20"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\AdminPanel\\": "Modules/AdminPanel/app/",
            "Modules\\AdminPanel\\Database\\Factories\\": "Modules/AdminPanel/database/factories/",
            "Modules\\AdminPanel\\Database\\Seeders\\": "Modules/AdminPanel/database/seeders/",
            "Modules\\Attendance\\": "Modules/Attendance/app/",
            "Modules\\Attendance\\Database\\Factories\\": "Modules/Attendance/database/factories/",
            "Modules\\Attendance\\Database\\Seeders\\": "Modules/Attendance/database/seeders/",
            "Modules\\Companies\\": "Modules/Companies/app/",
            "Modules\\Companies\\Database\\Factories\\": "Modules/Companies/database/factories/",
            "Modules\\Companies\\Database\\Seeders\\": "Modules/Companies/database/seeders/",
            "Modules\\Core\\": "Modules/Core/app/",
            "Modules\\Core\\Database\\Factories\\": "Modules/Core/database/factories/",
            "Modules\\Core\\Database\\Seeders\\": "Modules/Core/database/seeders/",
            "Modules\\Documents\\": "Modules/Documents/app/",
            "Modules\\Documents\\Database\\Factories\\": "Modules/Documents/database/factories/",
            "Modules\\Documents\\Database\\Seeders\\": "Modules/Documents/database/seeders/",
            "Modules\\Employees\\": "Modules/Employees/app/",
            "Modules\\Employees\\Database\\Factories\\": "Modules/Employees/database/factories/",
            "Modules\\Employees\\Database\\Seeders\\": "Modules/Employees/database/seeders/",
            "Modules\\Payroll\\": "Modules/Payroll/app/",
            "Modules\\Payroll\\Database\\Factories\\": "Modules/Payroll/database/factories/",
            "Modules\\Payroll\\Database\\Seeders\\": "Modules/Payroll/database/seeders/",
            "Modules\\Requests\\": "Modules/Requests/app/",
            "Modules\\Requests\\Database\\Factories\\": "Modules/Requests/database/factories/",
            "Modules\\Requests\\Database\\Seeders\\": "Modules/Requests/database/seeders/",
            "Modules\\Users\\": "Modules/Users/app/",
            "Modules\\Users\\Database\\Factories\\": "Modules/Users/database/factories/",
            "Modules\\Users\\Database\\Seeders\\": "Modules/Users/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\AdminPanel\\Tests\\": "Modules/AdminPanel/tests/",
            "Modules\\Attendance\\Tests\\": "Modules/Attendance/tests/",
            "Modules\\Companies\\Tests\\": "Modules/Companies/tests/",
            "Modules\\Core\\Tests\\": "Modules/Core/tests/",
            "Modules\\Documents\\Tests\\": "Modules/Documents/tests/",
            "Modules\\Employees\\Tests\\": "Modules/Employees/tests/",
            "Modules\\Payroll\\Tests\\": "Modules/Payroll/tests/",
            "Modules\\Requests\\Tests\\": "Modules/Requests/tests/",
            "Modules\\Users\\Tests\\": "Modules/Users/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
